# ogforge configuration — copy to .env and fill in:  cp env.sample .env
# The app RUNS without Razorpay keys (signup/login/image-gen/free-tier all work);
# only the paid upgrade flow needs them.

# Session cookie signing secret. Change in production.
SESSION_SECRET=dev-secret-change-me-in-production

# SQLite file path (relative to project root). In prod (Fly) this is /data/ogforge.db.
DB_PATH=ogforge.db

# Public base URL (used for redirects).
BASE_URL=http://localhost:8810

# --- Razorpay (India INR subscriptions) ---
# Dashboard -> Settings -> API Keys -> Generate Test Key (rzp_test_…).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# A monthly Plan id (created by setup_razorpay.sh, or in Dashboard -> Subscriptions -> Plans).
RAZORPAY_PLAN_ID=
# Dashboard -> Settings -> Webhooks -> add <BASE_URL>/billing/webhook, set a secret,
# subscribe to subscription.activated / .charged / .cancelled / .completed / .halted.
RAZORPAY_WEBHOOK_SECRET=

# (Optional) leave DATABASE_URL unset to use SQLite. Set a postgres:// URL to use Postgres.
DATABASE_URL=
