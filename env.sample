# ogforge configuration — copy to .env and fill in:  cp env.sample .env
# The app RUNS without Stripe keys (signup/login/image-gen/free-tier all work);
# only the paid upgrade flow needs them.

# Session cookie signing secret. Change in production.
SESSION_SECRET=dev-secret-change-me-in-production

# SQLite file path (relative to project root).
DB_PATH=ogforge.db

# Public base URL (used for Stripe success/cancel redirects).
BASE_URL=http://localhost:8810

# --- Stripe (test mode) ---
# Get these from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Create a recurring Price (e.g. $9/mo) and paste its price_... id here.
STRIPE_PRICE_ID=
# From `stripe listen` or the webhook endpoint settings (whsec_...).
STRIPE_WEBHOOK_SECRET=
